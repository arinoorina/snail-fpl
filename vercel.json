{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/fpl",
      "destination": "/api/fpl.js"
    },
    {
      "source": "/api/deadline",
      "destination": "/api/deadline.js"
    }
  ],
  "headers": [
    {
      "source": "/api/fpl",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "snail-fpl-data"
        }
      ]
    },
    {
      "source": "/api/deadline",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=300"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "snail-fpl-shell"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400, stale-if-error=1728000"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "snail-fpl-shell"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=1728000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
